    "Delete this game and all its moves? This cannot be undone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete this game and all its moves? This cannot be undone."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunąć tę grę wraz ze wszystkimi ruchami? Tej operacji nie można cofnąć."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видалити цю гру разом з усіма ходами? Цю дію не можна скасувати."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить эту партию вместе со всеми ходами? Это действие нельзя отменить."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Partie mit allen Zügen löschen? Das lässt sich nicht rückgängig machen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer cette partie et tous ses coups ? Cette action est irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminare questa partita e tutte le sue mosse? L’operazione non è reversibile."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除这盘棋及其全部着手？此操作无法撤销。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この対局と全ての着手を削除しますか？元に戻せません。"
          }
        }
      }
    },
