    "Saves these settings as your quick game preset when the game starts, and shakes start one like it." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sichert diese Einstellungen beim Start als Schnellpartie-Vorlage; Schütteln startet dann eine gleiche Partie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saves these settings as your quick game preset when the game starts, and shakes start one like it."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistre ces réglages comme partie rapide au démarrage ; secouer en lancera une identique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All’avvio salva queste impostazioni come partita rapida; scuotendo ne inizi una uguale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "対局開始時にこの設定をクイック対局として保存し、シェイクで同じ設定の対局を始めます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po rozpoczęciu gry zapisze te ustawienia jako szybką grę, a potrząśnięcie zacznie taką samą."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После начала партии сохранит эти настройки как быструю партию, и встряхивание начнёт такую же."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Після початку гри збереже ці налаштування як швидку гру, і струшування починатиме таку саму."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对局开始时将这些设置保存为快速对局预设，摇一摇即可开始同样的对局。"
          }
        }
      }
    },
