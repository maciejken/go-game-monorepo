          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GNU Go уже играет короткую партию — завершите или удалите её, прежде чем начинать новую."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GNU Go вже грає коротку партію — завершіть або видаліть її, перш ніж починати нову."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
