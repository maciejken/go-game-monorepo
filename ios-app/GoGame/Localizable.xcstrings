    "Delete this game and all its moves? This cannot be undone." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Partie mit allen Zügen löschen? Das lässt sich nicht rückgängig machen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delete this game and all its moves? This cannot be undone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimer cette partie et tous ses coups ? Cette action est irréversible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminare questa partita e tutte le sue mosse? L’operazione non è reversibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この対局と全ての着手を削除しますか？元に戻せません。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usunąć tę grę wraz ze wszystkimi ruchami? Tej operacji nie można cofnąć."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удалить эту партию вместе со всеми ходами? Это действие нельзя отменить."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Видалити цю гру разом з усіма ходами? Цю дію не можна скасувати."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除这盘棋及其全部着手？此操作无法撤销。"
          }
        }
      }
    },
    "Deletes your account and the games you played alone. Games against other players stay with them, without your name." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht dein Konto und die Partien, die du allein gespielt hast. Partien gegen andere bleiben bei ihnen, ohne deinen Namen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deletes your account and the games you played alone. Games against other players stay with them, without your name."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime votre compte et les parties jouées seul. Les parties contre d'autres joueurs restent chez eux, sans votre nom."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina il tuo account e le partite giocate da solo. Le partite contro altri giocatori restano a loro, senza il tuo nome."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントと、ひとりで打った対局を削除します。他の人との対局は相手の側に残りますが、あなたの名前は表示されません。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuwa Twoje konto i partie rozegrane samodzielnie. Partie z innymi graczami pozostaną u nich, bez Twojej nazwy."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаляет вашу учётную запись и партии, сыгранные в одиночку. Партии с другими игроками останутся у них, без вашего имени."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Видаляє ваш обліковий запис і партії, зіграні наодинці. Партії з іншими гравцями залишаться в них, без вашого імені."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除你的账号以及你独自下的对局。与其他玩家的对局会留在他们那里，但不再显示你的名字。"
          }
        }
      }
    },
