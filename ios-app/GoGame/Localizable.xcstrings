    "The code you were given when the account was made. Using it sets a new password and gives you a new code." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Code, den du beim Anlegen des Kontos bekommen hast. Ihn zu benutzen setzt ein neues Passwort und gibt dir einen neuen Code."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The code you were given when the account was made. Using it sets a new password and gives you a new code."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le code reçu à la création du compte. L'utiliser définit un nouveau mot de passe et vous en donne un nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
