    "Shake the phone to start a game with these settings. Ignored while a game is open.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shake the phone to start a game with these settings. Ignored while a game is open."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrząśnij telefonem, aby rozpocząć grę z tymi ustawieniami. Pomijane, gdy gra jest otwarta."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Струсіть телефон, щоб почати гру з цими налаштуваннями. Ігнорується, поки відкрита гра."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Встряхните телефон, чтобы начать партию с этими настройками. Игнорируется, пока открыта партия."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schüttle das Telefon, um eine Partie mit diesen Einstellungen zu starten. Wird ignoriert, solange eine Partie offen ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Secouez le téléphone pour démarrer une partie avec ces réglages. Ignoré lorsqu’une partie est ouverte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scuoti il telefono per iniziare una partita con queste impostazioni. Ignorato mentre una partita è aperta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "摇动手机即可用这些设置开始对局。打开棋局时不生效。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本体を振ると、この設定で対局を始めます。対局中は無効です。"
          }
        }
      }
    },
