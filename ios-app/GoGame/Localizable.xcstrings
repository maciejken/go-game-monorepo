    "GNU Go already has a short game in progress — finish or delete it before starting another.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GNU Go already has a short game in progress — finish or delete it before starting another."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "GNU Go gra już krótką partię — dokończ ją lub usuń, zanim zaczniesz następną."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "GNU Go вже грає коротку партію — завершіть або видаліть її, перш ніж починати нову."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "GNU Go уже играет короткую партию — завершите или удалите её, прежде чем начинать новую."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GNU Go spielt bereits eine kurze Partie — beende oder lösche sie, bevor du eine neue startest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GNU Go joue déjà une partie courte — terminez-la ou supprimez-la avant d’en commencer une autre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "GNU Go sta già giocando una partita breve — concludila o eliminala prima di iniziarne un’altra."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GNU Go 已有一盘快棋在进行 —— 请先下完或删除后再开新局。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GNU Goはすでに短時間の対局中です — 終局するか削除してから新しい対局を始めてください。"
          }
        }
      }
    },
    "GNU Go is not installed on the server — AI games are unavailable.": {
