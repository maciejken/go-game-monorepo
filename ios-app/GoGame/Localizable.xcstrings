    "Favourites are one of your own tags. Choose which tag marks them, then tag any game with it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Favourites are one of your own tags. Choose which tag marks them, then tag any game with it."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ulubione to jeden z Twoich tagów. Wybierz, który z nich je oznacza, a potem oznaczaj nim gry."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обране — це один із ваших тегів. Виберіть, який тег його позначає, і позначайте ним ігри."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Избранное — это один из ваших тегов. Выберите, какой тег его обозначает, и отмечайте им партии."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Favoriten sind einer deiner eigenen Tags. Wähle, welcher sie markiert, und tagge damit jede Partie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les favoris sont l'un de vos propres tags. Choisissez celui qui les marque, puis taguez vos parties avec."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I preferiti sono uno dei tuoi tag. Scegli quale li segna, poi usalo per taggare le partite."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收藏就是你自己的一个标签。选择用哪个标签表示收藏，然后用它标记对局。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お気に入りは自分のタグのひとつです。どのタグで示すかを選び、対局にそのタグを付けてください。"
          }
        }
      }
