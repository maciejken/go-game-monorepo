    "Marking seki groups — click a stone to toggle its group. Stays on the board; scores nothing for either side.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Marking seki groups — click a stone to toggle its group. Stays on the board; scores nothing for either side."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oznaczanie grup seki — kliknij kamień, aby przełączyć jego grupę. Zostaje na planszy i nie liczy się nikomu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Позначення груп секі — натисніть камінь, щоб перемкнути його групу. Залишається на дошці й нікому не зараховується."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отметка групп сэки — нажмите камень, чтобы переключить его группу. Остаётся на доске и никому не засчитывается."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seki-Gruppen markieren — klicke einen Stein an, um seine Gruppe umzuschalten. Sie bleibt auf dem Brett und zählt für keine Seite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marquage des groupes seki — cliquez une pierre pour basculer son groupe. Il reste sur le goban et ne compte pour personne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Marcatura dei gruppi seki — clicca una pietra per marcarne il gruppo. Resta sul goban e non conta per nessuno."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标记双活棋块 —— 点击棋子可切换其整块棋。棋子留在盘上，双方都不计目。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セキのマーク — 石をタップするとその一団を切り替えます。盤上に残り、どちらの地にもなりません。"
          }
        }
      }
    },
