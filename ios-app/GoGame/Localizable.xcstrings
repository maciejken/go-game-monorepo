    "GNU Go already has a short game in progress — finish or delete it before starting another." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GNU Go spielt bereits eine kurze Partie — beende oder lösche sie, bevor du eine neue startest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GNU Go already has a short game in progress — finish or delete it before starting another."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GNU Go joue déjà une partie courte — terminez-la ou supprimez-la avant d’en commencer une autre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GNU Go sta già giocando una partita breve — concludila o eliminala prima di iniziarne un’altra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GNU Goはすでに短時間の対局中です — 終局するか削除してから新しい対局を始めてください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
