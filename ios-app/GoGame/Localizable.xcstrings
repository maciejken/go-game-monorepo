    "Play on this device, or with someone nearby. Games stay here until you publish them." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spiele auf diesem Gerät oder mit jemandem in der Nähe. Partien bleiben hier, bis du sie veröffentlichst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play on this device, or with someone nearby. Games stay here until you publish them."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jouez sur cet appareil, ou avec quelqu'un à proximité. Les parties restent ici jusqu'à ce que vous les publiiez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gioca su questo dispositivo o con qualcuno nelle vicinanze. Le partite restano qui finché non le pubblichi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この端末で、または近くの人と対局できます。対局は公開するまでこの端末に残ります。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Graj na tym urządzeniu lub z kimś w pobliżu. Partie zostają tutaj, dopóki ich nie opublikujesz."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Играйте на этом устройстве или с кем-то рядом. Партии остаются здесь, пока вы их не опубликуете."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Грайте на цьому пристрої або з кимось поблизу. Партії залишаються тут, доки ви їх не опублікуєте."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在本机下棋，或与附近的人对局。对局会留在本机，直到你发布它们。"
          }
        }
      }
    },
