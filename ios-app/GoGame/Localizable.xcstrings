    "Write this down. It is the only way back into your account if you forget your password, and it isn't shown again." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schreib ihn auf. Er ist der einzige Weg zurück in dein Konto, wenn du dein Passwort vergisst, und wird nicht noch einmal angezeigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Write this down. It is the only way back into your account if you forget your password, and it isn't shown again."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notez-le. C'est le seul moyen de retrouver votre compte si vous oubliez votre mot de passe, et il ne sera plus affiché."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annotalo. È l'unico modo per rientrare nel tuo account se dimentichi la password, e non verrà mostrato di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "書き留めてください。パスワードを忘れたときにアカウントへ戻る唯一の方法で、二度と表示されません。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisz go. To jedyny sposób na odzyskanie konta, jeśli zapomnisz hasła — nie pokażemy go ponownie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запишите его. Это единственный способ вернуться в учётную запись, если вы забудете пароль — повторно он не показывается."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запишіть його. Це єдиний спосіб повернутися до облікового запису, якщо забудете пароль — вдруге його не покажемо."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请记下来。忘记密码时，这是回到账号的唯一办法，而且不会再次显示。"
          }
        }
      }
    },
